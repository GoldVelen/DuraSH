{
  "name": "@durash/dsh-web-profile",
  "description": "DuraSH product overlay for the upstream DeepSeek Harness Web profile",
  "version": "0.1.2-alpha.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldVelen/DuraSH.git",
    "directory": "packages/bundle/durash-web-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@durash/dsh-client-ui-brand": "workspace:^",
    "@durash/dsh-client-ui-reliability": "workspace:^",
    "@durash/dsh-reliability-loop": "workspace:^",
    "@durash/dsh-reliability-policy": "workspace:^",
    "@durash/dsh-tool-reliability": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "js-yaml": "^4.2.0"
  }
}
